# Copy this file to ".env" and populate it. ".env" is gitignored.

# Redis - fast read layer (live order book, snapshots, agent state)
REDIS_URL="redis://localhost:6379/0"

# PostgreSQL - long-term persistence (host port 5433 to avoid clashing with frontend db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/market_sim"

# Alpaca market data (REST + WebSocket)
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
